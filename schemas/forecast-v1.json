{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NFL lab scalar forecast consumer v1",
  "type": "object",
  "required": ["player_id", "sleeper_id", "game_id", "team", "opponent", "target", "period", "model_id", "scoring_id", "model_config_sha256", "input_sha256", "code_sha256", "kickoff_utc", "issued_at", "mean", "fallback", "prediction_functional"],
  "properties": {
    "player_id": {"type": "string", "minLength": 1},
    "sleeper_id": {"type": "string", "minLength": 1},
    "game_id": {"type": "string", "minLength": 1},
    "team": {"type": "string", "minLength": 1},
    "opponent": {"type": "string", "minLength": 1},
    "target": {"enum": ["pass_yd", "pass_td", "pass_cmp", "pass_att", "pass_int", "rush_yd", "rush_att", "rec", "rec_yd", "rush_rec_yd", "fantasy_ppr", "anytime_td"]},
    "period": {"const": "full_game"},
    "mean": {"type": "number"},
    "model_id": {"type": "string", "minLength": 1},
    "scoring_id": {"type": "string", "minLength": 1},
    "model_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "code_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "kickoff_utc": {"type": "string", "format": "date-time"},
    "issued_at": {"type": "string", "format": "date-time"},
    "fallback": {"type": ["string", "null"]},
    "prediction_functional": {"const": "conditional_played_mean"}
  },
  "allOf": [
    {"if": {"properties": {"target": {"enum": ["pass_td", "pass_cmp", "pass_att", "pass_int", "rush_att", "rec"]}}}, "then": {"properties": {"mean": {"minimum": 0}}}},
    {"if": {"properties": {"target": {"const": "anytime_td"}}}, "then": {"properties": {"mean": {"minimum": 0, "maximum": 1}}}}
  ]
}
