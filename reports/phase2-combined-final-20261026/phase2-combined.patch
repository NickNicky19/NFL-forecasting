+"""Exact public Classic1 engine bytes for fictional retained-profile controls."""
+import hashlib
+from pathlib import Path
+import subprocess
+
+SOURCE = "453e7e6e843b0cb1ae611b0925063e0f96c70196"
+
+
+def install(root, repository=None):
+    import classic_model_v1 as classic
+    repository = Path(repository or Path(__file__).resolve().parents[1])
+    root = Path(root)
+    for name, expected in classic.ENGINE.items():
+        body = subprocess.check_output(["git", "--no-lazy-fetch", "show", SOURCE+":"+name], cwd=repository)
+        if len(body) > 2 << 20 or hashlib.sha256(body).hexdigest() != expected:
+            raise AssertionError("frozen Classic1 source differs: "+name)
+        target = root/name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(body)
+    return classic.contract(root)
+
+
+def install_presence(root, repository=None):
+    """Authenticate the retained modern-v2 engine for its original cohort."""
+    import data_integrity_v2 as corrected
+    repository = Path(repository or Path(__file__).resolve().parents[1])
+    root = Path(root)
+    for name, expected in corrected.V2_SOURCE_SHA256.items():
+        body = subprocess.check_output(["git", "--no-lazy-fetch", "show",
+            corrected.RETAINED_CORRECTED_SOURCE+":"+name], cwd=repository)
+        if len(body) > 2 << 20 or hashlib.sha256(body).hexdigest() != expected:
+            raise AssertionError("frozen modern-v2 source differs: "+name)
+        target = root/name; target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(body)
+    return corrected.engine_files(root, model=corrected.MODEL)
